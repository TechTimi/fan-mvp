{
  "name": "fan-mvp",
  "version": "1.0.0",
  "description": "Fuel Advance Network MVP - Fintech app for fuel advances",
  "main": "index.js",
  "scripts": {
    "dev": "node backend/index.js",
    "start": "node backend/index.js",
    "build": "npm run build:frontend && npm run build:mobile",
    "build:frontend": "cd frontend && npm run build",
    "build:mobile": "cd mobile && expo build",
    "test": "jest",
    "lint": "eslint .",
    "install:all": "npm install && cd mobile && npm install && cd ../frontend && npm install && cd ../backend && npm install"
  },
  "keywords": ["fintech", "fuel", "advance", "payment", "mobile"],
  "author": "TechTimi",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "firebase-admin": "^11.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "eslint": "^8.47.0",
    "nodemon": "^3.0.1"
  }
}
